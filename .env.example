# Default allocation used by the main experiment:
# - Coordinator, Analyst, Reporter: models/gemma-4-26b-a4b-it
# - Hunter, Verifier, Tools, Debate Feedback, Debate Judge: gpt-4.1-mini
# Uncomment the shared toggles below to force a homogeneous-model benchmark.
# AGENT_LLM_PROVIDER=deepseek
# AGENT_MODEL=deepseek-v4-pro
AGENT_MODEL_TIMEOUT_SECONDS=300

# Scenario & strategy selection (flexible switching across extracted_scenarios and datasets):
# Available extracted scenarios: S07, S16, S23
# Available legacy datasets: CobaltStrike_Lockbit, Lynx_Ransomware
SCENARIO_ID=S23
COLLABORATION_STRATEGY=hierarchical
TASK_EVENT_LIMIT=120
# DOMAIN_PACK_PATH=skills/default_domain_pack.json

# Orchestration-layer ablation toggles (ttp_relations_graph and mitre_mapper are now decoupled):
ENABLE_DAG_ORCHESTRATOR=true
ENABLE_IOC_CURATOR=true
ENABLE_TTP_RELATIONS_GRAPH=true
ENABLE_MITRE_MAPPER=true

# Upcoming EP-HARNESS configuration toggles (registered in orchestration_toggles; runtime enforcement deferred):
ENABLE_CONTRACT_GATE=false
ENABLE_SEMANTIC_VERIFIER=false
POLICY_MODE=fixed
ENABLE_OUTPUT_GUARDRAIL=false

# Required when using the DeepSeek homogeneous override above.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_MODE=disabled

# Optional per-component overrides for A/B benchmarks.
# COORDINATOR_LLM_PROVIDER=deepseek
# COORDINATOR_MODEL=deepseek-v4-pro
# HUNTER_LLM_PROVIDER=deepseek
# HUNTER_MODEL=deepseek-v4-pro
# VERIFIER_LLM_PROVIDER=deepseek
# VERIFIER_MODEL=deepseek-v4-pro
# ANALYST_LLM_PROVIDER=deepseek
# ANALYST_MODEL=deepseek-v4-pro
# REPORTER_LLM_PROVIDER=deepseek
# REPORTER_MODEL=deepseek-v4-pro
# TOOLS_LLM_PROVIDER=deepseek
# TOOLS_MODEL=deepseek-v4-pro
# DEBATE_FEEDBACK_LLM_PROVIDER=deepseek
# DEBATE_FEEDBACK_MODEL=deepseek-v4-pro
# DEBATE_JUDGE_LLM_PROVIDER=deepseek
# DEBATE_JUDGE_MODEL=deepseek-v4-pro

# Keys used only when switching the provider above.
# OPENAI_API_KEY=sk-your-openai-key
# GOOGLE_API_KEY=your-google-key
