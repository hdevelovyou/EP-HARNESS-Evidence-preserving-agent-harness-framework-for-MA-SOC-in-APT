# Default homogeneous allocation used by the main experiment:
# - All agents (Coordinator, Hunter, Verifier, Analyst, Reporter, Tools, Debate Feedback, Debate Judge): models/gemma-4-26b-a4b-it
AGENT_LLM_PROVIDER=google
AGENT_MODEL=models/gemma-4-26b-a4b-it
AGENT_MODEL_TIMEOUT_SECONDS=300

# Scenario & strategy selection (flexible switching across extracted_scenarios and datasets):
# Available extracted scenarios: S07, S16, S23
# Available legacy datasets: CobaltStrike_Lockbit, Lynx_Ransomware
SCENARIO_ID=S23
COLLABORATION_STRATEGY=hierarchical
TASK_EVENT_LIMIT=120
# DOMAIN_PACK_PATH=skills/default_domain_pack.json

# Orchestration-layer ablation toggles (ttp_relations_graph and mitre_mapper are now decoupled):
ENABLE_DAG_ORCHESTRATOR=true
ENABLE_IOC_CURATOR=true
ENABLE_TTP_RELATIONS_GRAPH=true
ENABLE_MITRE_MAPPER=true

# EP-HARNESS configuration toggles (Structured Capsule Baseline: non-semantic-verified, non-adaptive):
ENABLE_CONTRACT_GATE=true
ENABLE_CITED_CLAIMS=true
CONTRACT_GATE_ANALYST_RETRIES=1
ENABLE_SEMANTIC_VERIFIER=false
POLICY_MODE=fixed
ENABLE_OUTPUT_GUARDRAIL=false

# Required only when switching to DeepSeek override.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_MODE=disabled

# Per-component model configuration (homogeneous gemma-4-26b-a4b-it across all agents):
COORDINATOR_LLM_PROVIDER=google
COORDINATOR_MODEL=models/gemma-4-26b-a4b-it
HUNTER_LLM_PROVIDER=google
HUNTER_MODEL=models/gemma-4-26b-a4b-it
VERIFIER_LLM_PROVIDER=google
VERIFIER_MODEL=models/gemma-4-26b-a4b-it
ANALYST_LLM_PROVIDER=google
ANALYST_MODEL=models/gemma-4-26b-a4b-it
REPORTER_LLM_PROVIDER=google
REPORTER_MODEL=models/gemma-4-26b-a4b-it
TOOLS_LLM_PROVIDER=google
TOOLS_MODEL=models/gemma-4-26b-a4b-it
DEBATE_FEEDBACK_LLM_PROVIDER=google
DEBATE_FEEDBACK_MODEL=models/gemma-4-26b-a4b-it
DEBATE_JUDGE_LLM_PROVIDER=google
DEBATE_JUDGE_MODEL=models/gemma-4-26b-a4b-it

# Keys used only when switching the provider above.
# OPENAI_API_KEY=sk-your-openai-key
# GOOGLE_API_KEY=your-google-key
