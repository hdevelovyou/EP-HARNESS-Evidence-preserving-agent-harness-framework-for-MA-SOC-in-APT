{
  "name": "ep-harness",
  "version": "0.2.0",
  "components": [
    {
      "name": "evidence_ledger",
      "category": "evidence_provenance",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "status_transitions": "capsule.STATUS_TRANSITIONS"
      }
    },
    {
      "name": "evidence_capsule",
      "category": "evidence_provenance",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "schema": "schemas/evidence_capsule.v0.2.json"
      }
    },
    {
      "name": "contract_gate",
      "category": "hooks_middleware",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "checks": [
          "C1",
          "C2",
          "C3",
          "C4",
          "R1",
          "R2",
          "R3",
          "R4"
        ],
        "semantic_check": "not_performed"
      }
    },
    {
      "name": "contract_registry",
      "category": "tools_skills",
      "version": "0.1.0",
      "enabled": true,
      "config": {
        "source": "masoc agents/task_catalog.py"
      }
    },
    {
      "name": "masoc_shadow_adapter",
      "category": "observability_evaluation",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "lineage": "derived",
        "min_observable_len": 4
      }
    },
    {
      "name": "inline_ech",
      "category": "hooks_middleware",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "toggle": "ENABLE_CONTRACT_GATE",
        "edges": [
          "hunter->verifier",
          "verifier->analyst",
          "analyst->reporter"
        ],
        "record_only_edges": [
          "reporter->output"
        ],
        "analyst_retries_env": "CONTRACT_GATE_ANALYST_RETRIES",
        "claim_source_env": "ENABLE_CITED_CLAIMS"
      }
    },
    {
      "name": "claim_parser",
      "category": "hooks_middleware",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "fence": "evidence_claims",
        "agents": [
          "hunter",
          "analyst"
        ],
        "toggle": "ENABLE_CITED_CLAIMS",
        "format_repair": true,
        "auto_tag_threshold": 0.6
      }
    },
    {
      "name": "semantic_evidence_verifier",
      "category": "hooks_middleware",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "toggle": "ENABLE_SEMANTIC_VERIFIER",
        "requires": "ENABLE_CONTRACT_GATE",
        "verdicts": [
          "SUPPORTED",
          "INSUFFICIENT",
          "UNRELATED",
          "CONTRADICTED",
          "NOT_APPLICABLE"
        ],
        "layers": [
          "rules",
          "judge"
        ],
        "trivial_df": 0.3,
        "time_tolerance_min": 10
      }
    },
    {
      "name": "evidence_cards",
      "category": "system_prompts",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "toggle": "ENABLE_CITED_CLAIMS",
        "agent": "hunter",
        "placement": "before_task_view"
      }
    },
    {
      "name": "adaptive_policy",
      "category": "orchestration",
      "version": "adaptive-1",
      "enabled": true,
      "config": {
        "toggle": "POLICY_MODE",
        "modes": [
          "fixed",
          "adaptive",
          "always_review"
        ],
        "requires": "ENABLE_CONTRACT_GATE",
        "budget_env": [
          "POLICY_TASK_RETRIES",
          "POLICY_REVIEW_BUDGET",
          "POLICY_LLM_CALL_BUDGET"
        ],
        "defaults": {
          "task_retries": 1,
          "reviews": 5,
          "llm_calls": 0
        }
      }
    },
    {
      "name": "label_guard",
      "category": "trust_boundary",
      "version": "0.2.0",
      "enabled": true,
      "config": {
        "always_on": true,
        "pattern": "T\\d{4}(\\.\\d{3})?",
        "pseudonym": "XTIDnn",
        "markers_env": "MASK_SIMULATION_MARKERS",
        "unmask": "path-like tokens, post-seal IOC scoring only"
      }
    }
  ]
}
