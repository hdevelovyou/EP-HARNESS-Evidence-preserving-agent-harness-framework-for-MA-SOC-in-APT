      "taskeng.exe",
      "tasklist.exe",
      "wevtutil.exe",
      "winword.exe",
      "wmic.exe",
      "wsmprovhost.exe"
    ],
    "known_contextual_domains": [
      "mitre.org",
      "attack.mitre.org",
      "virustotal.com"
    ],
    "contextual_domain_suffixes": [],
    "contextual_ip_rules": [],
    "suspicious_terms": [
      "malicious",
      "suspicious",
      "credential",
      "dump",
      "lsass",
      "persistence",
      "run key",
      "scheduled task",
      "disable",
      "defender",
      "encrypt",
      "exfil",
