{
  "pack_name": "ep_harness_default_windows_soc_pack",
  "version": "1.0.0",
  "description": "Externalized domain knowledge pack (Skills layer) for Windows/APT SOC hunting: observable suffixes, benign/contextual exclusions, MITRE ATT&CK graph weights, TTP evidence-hypothesis rules, and MitreMapper scoring heuristics.",
  "tools": {
    "file_suffixes": [
      "7z", "aspx", "bat", "bin", "cab", "cmd", "db", "dit", "dll", "dmp",
      "doc", "docm", "docx", "exe", "hta", "js", "jse", "json", "lnk", "log",
      "msi", "pdf", "ps1", "py", "rar", "sh", "sys", "tmp", "txt", "url",
      "vbs", "xls", "xlsx", "xml", "zip"
    ],
    "pattern_file_suffixes": [
      "7z", "aspx", "bat", "bin", "cab", "cmd", "db", "dit", "dll", "dmp",
      "doc", "docm", "docx", "exe", "hta", "js", "jse", "lnk", "log", "msi",
      "pdf", "ps1", "py", "rar", "sh", "sys", "tmp", "txt", "url", "vbs",
      "xls", "xlsx", "xml", "zip"
    ],
    "executable_extensions": [
      ".exe", ".dll", ".bat", ".cmd", ".ps1", ".vbs", ".js", ".jse", ".hta", ".msi"
    ],
    "security_line_keywords": [
      "powershell", "cmd.exe", "rundll32", "regsvr32", "mshta", "schtasks",
      "ntdsutil", "lsass", "procdump", "vssadmin", "credential", "password",
      "hash", "defender", "set-mppreference", "wmic", "psexec", "plink",
      "smb", "ftp", "curl", "download", "execute", "process", "command",
      "network", "dns", "http", "https", "domain", "ip", "exfil", "encrypt",
      "registry", "service"
    ]
  },
  "ioc_curator": {
    "hash_types": ["md5", "sha1", "sha256"],
    "suspicious_file_extensions": [
      ".exe", ".dll", ".bat", ".cmd", ".ps1", ".vbs", ".js", ".jse", ".hta",
      ".msi", ".dmp", ".dit", ".aspx", ".sys"
    ],
    "file_pattern_extensions": [
      "7z", "aspx", "bat", "bin", "cab", "cmd", "db", "dit", "dll", "dmp",
      "doc", "docm", "docx", "exe", "hta", "js", "jse", "lnk", "log", "msi",
      "pdf", "ps1", "py", "rar", "sh", "sys", "tmp", "txt", "url", "vbs",
      "xls", "xlsx", "xml", "zip"
    ],
    "domain_tlds": [
      "com", "net", "org", "info", "biz", "vn", "io", "ru", "xyz",
      "top", "cc", "cn", "gov", "edu", "mil", "uk", "de", "fr", "jp",
      "kr", "cloud", "online", "site", "tech", "dev", "app", "me", "co",
      "us", "in", "br", "au", "ca"
    ],
    "common_benign_files": [
      "7z.exe",
      "chrome.exe",
      "cmd.exe",
      "curl.exe",
      "explorer.exe",
      "ftp.exe",
      "gpresult.exe",
      "net.exe",
      "nltest.exe",
      "ntdsutil.exe",
      "onedrivesetup.exe",
      "powershell.exe",
      "rundll32.exe",
      "services.exe",
